msgstr "Soglasje je bilo zabeleženo."

#: includes/class-edu-admin.php:315
msgid "Der Widerruf wurde erfasst."
msgstr "Preklic je bil zabeležen."

#: includes/class-edu-admin.php:316
msgid "Die Einwilligungsart wurde angelegt."
msgstr "Vrsta soglasja je bila ustvarjena."

#: includes/class-edu-admin.php:317
