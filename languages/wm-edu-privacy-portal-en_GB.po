msgstr "Pupil ID / Token"

#: includes/class-edu-shortcodes.php:168
msgid "Einwilligung prüfen"
msgstr "Check consent"

#: includes/class-edu-shortcodes.php:178
msgid ""
"Die Sicherheitsprüfung ist fehlgeschlagen. Bitte laden Sie die Seite neu und "
"versuchen Sie es erneut."
msgstr "Security verification failed. Please reload the page and try again."

#. translators: %s: pupil token.
#: includes/class-edu-shortcodes.php:186
#, php-format
msgid ""
