#: includes/class-edu-shortcodes.php:102
#, php-format
msgid "Pseudonymisierter Text (%d Datum oder Klassenbezeichnung ersetzt)"
msgid_plural ""
"Pseudonymisierter Text (%d Datumsangaben oder Klassenbezeichnungen ersetzt)"
msgstr[0] "Pseudonimizuotas tekstas (pakeista %d data arba klasė)"
msgstr[1] "Pseudonimizuotas tekstas (pakeistos %d datos arba klasės)"
msgstr[2] "Pseudonimizuotas tekstas (pakeista %d datų arba klasių)"

#: includes/class-edu-shortcodes.php:107
msgid ""
"Hinweis: Schülernamen werden nur pseudonymisiert, wenn die Schülerliste der "
"Schule als known_students an die REST-Route wm-edu/v1/tokenize übergeben "
"wird. Diese Demo ersetzt Datumsangaben und Klassenbezeichnungen."
msgstr ""
"Pastaba: mokinių vardai pseudonimizuojami tik pateikus sąrašą kaip "
"known_students REST maršrutui wm-edu/v1/tokenize. Ši demonstracija pakeičia "
"datas ir klases."

