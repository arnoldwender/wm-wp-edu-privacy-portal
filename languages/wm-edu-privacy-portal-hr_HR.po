msgid_plural ""
"Pseudonymisierter Text (%d Datumsangaben oder Klassenbezeichnungen ersetzt)"
msgstr[0] "Pseudonimizirani tekst (zamijenjen %d datum ili oznaka razreda)"
msgstr[1] "Pseudonimizirani tekst (zamijenjena %d datuma ili oznake razreda)"
msgstr[2] "Pseudonimizirani tekst (zamijenjeno %d datuma ili oznaka razreda)"

#: includes/class-edu-shortcodes.php:107
msgid ""
"Hinweis: Schülernamen werden nur pseudonymisiert, wenn die Schülerliste der "
"Schule als known_students an die REST-Route wm-edu/v1/tokenize übergeben "
"wird. Diese Demo ersetzt Datumsangaben und Klassenbezeichnungen."
msgstr ""
"Napomena: imena učenika pseudonimiziraju se samo kada se popis škole preda "
"kao known_students REST ruti wm-edu/v1/tokenize. Ova demonstracija "
"zamjenjuje datume i razrede."

