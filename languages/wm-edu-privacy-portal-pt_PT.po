msgstr "A pseudonimização devolve valores divergentes."

#: includes/class-edu-spoke-adapter.php:145
msgid "Die Pseudonymisierung ist abgebrochen."
msgstr "A pseudonimização foi interrompida."

#: includes/class-edu-spoke-adapter.php:156
msgid "Selbsttest fehlgeschlagen:"
msgstr "Autoteste falhou:"

#. translators: 1: rows verified, 2: rows in the ledger.
#: includes/class-edu-spoke-adapter.php:162
#, php-format
msgid ""
"Pseudonymisierung ersetzt Namen, Klasse und Datum; Einwilligungskette gültig "
