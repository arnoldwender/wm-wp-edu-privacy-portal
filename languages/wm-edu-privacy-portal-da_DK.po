msgstr "Gemmes i registret og kan ikke ændres senere, f.eks. FAHRT_2026."

#: includes/class-edu-admin.php:528
msgid "Beschreibung"
msgstr "Beskrivelse"

#: includes/class-edu-admin.php:530
